meta {
  name: 01 Crear reserva (en 5 min -> active)
  type: http
  seq: 1
}

post {
  url: http://localhost:1880/reservas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

assert {
  res.status: eq 201
  res.body.reservation_id: eq {{ridA}}
  res.body.status: eq active
}

script:pre-request {
  const now = Date.now();
  
  const startsAt = new Date(now + 5 * 60000);
  const endsAt = new Date(now + 65 * 60000);
  
  function formatDate(date) {
      return date.toISOString().replace('Z', '-05:00');
  }
  
  req.setHeader("Content-Type", "application/json");
  
  req.setBody({
      reservation_id: "RSV-PRUEBA_AF4",
      node_id: "PARKING-003",
      space_id: "B-003",
      plate: "RES115",
      starts_at: formatDate(startsAt),
      ends_at: formatDate(endsAt)
  });
  
  console.log("Body enviado:", req.getBody());
}

docs {
  Empieza en 5 min (<= 10), así que nace `active` y Node-RED publica
  `bahia/reserva` con `reserved: true` en el mismo momento.
}
