meta {
  name: 03 Crear reserva (cruce en la bahia)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/reservas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reservation_id": "{{ridB}}",
    "node_id": "{{nodeId}}",
    "space_id": "{{bayA}}",
    "plate": "{{plateB}}",
    "starts_at": "{{start30}}",
    "ends_at": "{{end90}}"
  }
}

assert {
  res.status: eq 409
  res.body.error: eq OVERLAP
}

docs {
  Misma bahía (B-001) que la reserva 01 y franja que se cruza.
}
