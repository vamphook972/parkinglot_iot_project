meta {
  name: 10 Crear reserva (fecha sin zona horaria)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/reservas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reservation_id": "{{ridB}}",
    "node_id": "{{nodeId}}",
    "space_id": "{{bayC}}",
    "plate": "{{plateB}}",
    "starts_at": "2030-01-01T08:00:00",
    "ends_at": "2030-01-01T10:00:00"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq BAD_REQUEST
}
