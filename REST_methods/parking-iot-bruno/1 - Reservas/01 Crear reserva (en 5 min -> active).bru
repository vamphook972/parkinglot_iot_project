meta {
  name: 01 Crear reserva (en 5 min -> active)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reservas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reservation_id": "{{ridA}}",
    "node_id": "{{nodeId}}",
    "space_id": "{{bayA}}",
    "plate": "{{plateA}}",
    "starts_at": "{{start5}}",
    "ends_at": "{{end65}}"
  }
}

assert {
  res.status: eq 201
  res.body.reservation_id: eq {{ridA}}
  res.body.status: eq active
}

docs {
  Empieza en 5 min (<= 10), así que nace `active` y Node-RED publica
  `bahia/reserva` con `reserved: true` en el mismo momento.
}
