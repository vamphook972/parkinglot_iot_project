meta {
  name: 08 Crear reserva (franja ya terminada)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/reservas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reservation_id": "{{ridB}}",
    "node_id": "{{nodeId}}",
    "space_id": "{{bayC}}",
    "plate": "{{plateB}}",
    "starts_at": "{{pastStart}}",
    "ends_at": "{{pastEnd}}"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq BAD_REQUEST
}

docs {
  `ends_at` en el pasado: la validación ends_future falla.
}
