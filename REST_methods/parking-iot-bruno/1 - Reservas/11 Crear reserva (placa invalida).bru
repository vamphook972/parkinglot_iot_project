meta {
  name: 11 Crear reserva (placa invalida)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/reservas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reservation_id": "{{ridB}}",
    "node_id": "{{nodeId}}",
    "space_id": "{{bayC}}",
    "plate": "A!B#1",
    "starts_at": "{{start30}}",
    "ends_at": "{{end90}}"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq BAD_REQUEST
}
