meta {
  name: 07 Crear reserva (fechas al reves)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/reservas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reservation_id": "{{ridB}}",
    "node_id": "{{nodeId}}",
    "space_id": "{{bayC}}",
    "plate": "{{plateB}}",
    "starts_at": "{{end90}}",
    "ends_at": "{{start30}}"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq BAD_REQUEST
}
