meta {
  name: 05 Resumen con intento de SQL injection
  type: http
  seq: 5
}

get {
  url: http://localhost:1880/api/resumen/%27%20OR%20%271%27%3D%271
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("el parámetro va como ?, no se inyecta: lista vacía", function () {
    expect(res.body).to.be.an("array").that.is.empty;
  });
}

docs {
  Envía `' OR '1'='1` como :nodo. Como la consulta usa parámetros (?), no
  debe devolver todo.
}
