meta {
  name: 01 Comparar nodos
  type: http
  seq: 1
}

get {
  url: http://localhost:1880/api/nodos
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responde una lista", function () {
    expect(res.body).to.be.an("array");
  });
  test("cada fila trae node_id y bays", function () {
    res.body.forEach(function (f) {
      expect(f).to.have.property("node_id");
      expect(f).to.have.property("bays");
    });
  });
}
