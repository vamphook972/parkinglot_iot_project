meta {
  name: 06 Perfil por hora
  type: http
  seq: 6
}

get {
  url: http://localhost:1880/api/horas/TODOS
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("si hay datos, trae las 24 horas ordenadas", function () {
    expect(res.body).to.be.an("array");
    if (res.body.length > 0) {
      expect(res.body.length).to.equal(24);
      expect(res.body[0].hour).to.equal(0);
      expect(res.body[23].hour).to.equal(23);
    }
  });
}
