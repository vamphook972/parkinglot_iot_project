meta {
  name: 07 Serie por dia
  type: http
  seq: 7
}

get {
  url: http://localhost:1880/api/dias/TODOS
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responde una lista con day en formato YYYY-MM-DD", function () {
    expect(res.body).to.be.an("array");
    res.body.forEach(function (f) {
      expect(f.day).to.match(/^\d{4}-\d{2}-\d{2}$/);
    });
  });
}
